<!doctype html>
<html lang="en">
  <head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-Zenh87qX5JnK2Jl0vWa8Ck2rdkQ2Bzep5IDxbcnCeuOxjzrPF/et3URy9Bv1WTRi" crossorigin="anonymous">

    <title>Herramientas S.P.E. SRL</title>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    
    
  </head>
  <body>

    <%= render 'home/header' %>
    <div class="container">
    <% if notice %>
      <%= render 'layouts/alerts' %>
    <% end %>
          <%= yield %>
    </div>

    <!-- Optional JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-OERcA2EqjJCMA+/3y+gxIOqMEjwtxJY7qPCqsdltbNJuaOe923+mo//f6V8Qbsw3" crossorigin="anonymous"></script>
    <%= javascript_tag do %>
      function toggleLocationDetail(select) {
        var detailFieldId = select.dataset.locationDetailTarget;

        if (!detailFieldId) {
          return;
        }

        var detailField = document.getElementById(detailFieldId);

        if (!detailField) {
          return;
        }

        var wrapper = document.getElementById(detailFieldId.replace('detail', 'detail_wrapper'));
        var spacer = document.getElementById(detailFieldId.replace('detail', 'detail_spacer'));
        var shouldShow = select.value === 'Pozo';

        if (wrapper) {
          wrapper.classList.toggle('d-none', !shouldShow);
        }

        if (spacer) {
          spacer.classList.toggle('d-none', !shouldShow);
        }

        if (!shouldShow) {
          detailField.value = '';
        }
      }

      document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.js-location-option').forEach(function (select) {
          toggleLocationDetail(select);
        });
      });

      document.addEventListener('change', function (event) {
        if (event.target.matches('.js-location-option')) {
          toggleLocationDetail(event.target);
        }
      });

      document.addEventListener('click', function (event) {
        var button = event.target.closest('.js-load-more-events');

        if (!button) {
          return;
        }

        var eventsSection = button.closest('.tool-events');
        var hiddenItems = eventsSection.querySelectorAll('.tool-events-item-hidden');
        var loadCount = parseInt(button.dataset.loadCount || '10', 10);
        var remainingLabel = button.querySelector('.js-events-remaining');

        Array.prototype.slice.call(hiddenItems, 0, loadCount).forEach(function (item) {
          item.classList.remove('tool-events-item-hidden', 'd-none');
        });

        var remaining = eventsSection.querySelectorAll('.tool-events-item-hidden').length;

        if (remainingLabel) {
          remainingLabel.textContent = remaining;
        }

        if (remaining === 0) {
          button.remove();
        }
      });
    <% end %>
  </body>
</html>
