<%= form_with(model: tool) do |form| %>
  <% if tool.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(tool.errors.count, "error") %> prohibited this tool from being saved:</h2>
      <ul>
        <% tool.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
  <%= form.text_field :clase, class: "form-control", placeholder: "Tipo de Herramienta" %>
 </div>
 <br/>

  <div class="form-group">
    <%= form.text_field :id_tool, class: "form-control", placeholder: "ID" %>
  </div>
  <br/>

  <div class="form-group">
    <%= form.text_field :precinto, class: "form-control", placeholder: "Precinto" %>
  </div>
  <br/>

  <div class="form-group">
  <%= form.label :date_of_use, "Fecha de Uso" %>
  <%= form.date_field :date_of_use, class: "form-control", placeholder: "Fecha de Uso", value: tool.date_of_use.try(:to_date) %>
  </div>
  <br/>

  <div class="form-group">
  <%= form.text_field :pin, class: "form-control", placeholder: "Pin" %>
  </div>
  <br/>

  <div class="form-group">
  <%= form.text_field :box, class: "form-control", placeholder: "Box" %>
 </div>
 <br/>

  <div class="form-group">
    <%= label_tag "tool_location_option_form", "Ubicacion" %>
    <%= select_tag "tool[location_option]",
                   options_for_select(Tool::LOCATION_OPTIONS, tool.location_option),
                   include_blank: "Seleccionar ubicacion",
                   id: "tool_location_option_form",
                   class: "form-control js-location-option",
                   data: { location_detail_target: "tool_location_detail_form" } %>
  </div>
  <br/>

  <div class="form-group <%= 'd-none' unless tool.location_option == 'Pozo' %>" id="tool_location_detail_wrapper_form">
    <%= label_tag "tool_location_detail_form", "Detalle de Pozo" %>
    <%= text_field_tag "tool[location_detail]",
                       tool.location_detail,
                       id: "tool_location_detail_form",
                       class: "form-control js-location-detail",
                       placeholder: "Ejemplo: Pozo Norte" %>
  </div>
  <br class="<%= 'd-none' unless tool.location_option == 'Pozo' %>" id="tool_location_detail_spacer_form"/>

  <div class="form-group">
    <%= form.text_field :link_to_pdf, class: "form-control", placeholder: "Link Inspeccion" %>
  </div>
  <br/>

  <div class="form-group">
    <%= form.number_field :user_id, id: :tool_user_id, class: "form-control", value: current_user.id, type: :hidden %>
  </div>
  <br/>

  <div>
    <%= form.submit class: "btn btn-secondary" %>
  </div>
<% end %>
