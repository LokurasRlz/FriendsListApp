<% modal = local_assigns.fetch(:modal, false) %>
<% readonly_tool_url = tool_url(tool) %>
<% tool_events = tool.events.recent_first.to_a %>

<div id="<%= dom_id tool %>" class="<%= modal ? '' : 'container mt-5' %>">
  <div class="<%= modal ? '' : 'row justify-content-center' %>">
    <div class="<%= modal ? '' : 'col-md-6' %>">
      <div class="card h-100 text-bg-dark rounded-3">
        <div class="card-body">
          <h2 class="card-title text-primary"><%= tool.clase %></h2> <br/>
          <h2 class="card-title">ID: <%= tool.id_tool %></h2>
          <h2 class="card-title">Precinto: <%= tool.precinto %></h2> <br/>

          <div class="card-text">
            Pin: <%= tool.pin %> <br/>
            Box: <%= tool.box %> <br/> <br/>

            <% if user_signed_in? %>
              <div class="mt-3">
                <%= form_with(model: tool, url: tool_path(tool), method: :patch, local: true, html: { class: "update-date-form" }) do |form| %>
                  <%= form.hidden_field :authenticity_token %>

                  <div class="form-group">
                    <%= form.label :date_of_use, "Actualizar Fecha de Uso:" %>
                    <%= form.date_field :date_of_use, class: "form-control" %>
                  </div>
                  <br/>

                  <div class="form-group">
                    <%= form.label :date_due_to, "Actualizar Fecha de Vencimiento:" %>
                    <%= form.date_field :date_due_to, class: "form-control" %>
                  </div>
                  <br/>

                  <div class="form-group">
                    <%= label_tag "tool_location_option_#{tool.id}", "Actualizar Ubicacion:" %>
                    <%= select_tag "tool[location_option]",
                                   options_for_select(Tool::LOCATION_OPTIONS, tool.location_option),
                                   include_blank: "Seleccionar ubicacion",
                                   id: "tool_location_option_#{tool.id}",
                                   class: "form-control js-location-option",
                                   data: { location_detail_target: "tool_location_detail_#{tool.id}" } %>
                  </div>
                  <br/>

                  <div class="form-group <%= 'd-none' unless tool.location_option == 'Pozo' %>" id="tool_location_detail_wrapper_<%= tool.id %>">
                    <%= label_tag "tool_location_detail_#{tool.id}", "Detalle de Pozo:" %>
                    <%= text_field_tag "tool[location_detail]",
                                       tool.location_detail,
                                       id: "tool_location_detail_#{tool.id}",
                                       class: "form-control js-location-detail",
                                       placeholder: "Ejemplo: Pozo Norte" %>
                  </div>
                  <br class="<%= 'd-none' unless tool.location_option == 'Pozo' %>" id="tool_location_detail_spacer_<%= tool.id %>"/>

                  <%= form.submit "Actualizar", class: "btn btn-primary" %>
                <% end %>

                <div class="mt-3">
                  <%= button_to "Reset", update_date_of_use_tool_path(tool), method: :patch, params: { reset_date_of_use: true }, class: "btn btn-warning" %>
                </div>
              </div>
            <% end %>

            <br/>
            Ubicacion: <%= tool.location %> <br/>
            Fecha de Uso: <%= tool.date_of_use %> <br/>
            Fecha de Vencimiento: <%= tool.date_due_to %> <br/>
          </div>
          <br/>

          <div class="mt-1">
            <%= link_to "Inspeccion", tool.link_to_pdf, target: "_blank", class: "btn btn-success" %>
          </div>
          <br/>

          <% if modal %>
            <div class="tool-qr mt-4 text-center">
              <p class="mb-2">QR tarjeta solo lectura</p>
              <%= link_to readonly_tool_url, target: "_blank", rel: "noopener", class: "tool-qr-link d-inline-block bg-white p-2 rounded" do %>
                <%= image_tag qr_code_png_data(readonly_tool_url), alt: "QR de la tarjeta #{tool.id_tool}", class: "tool-qr-image" %>
              <% end %>
              <p class="small mt-2 mb-0">
                <%= link_to readonly_tool_url, readonly_tool_url, target: "_blank", rel: "noopener", class: "text-break" %>
              </p>
            </div>
          <% end %>

          <div class="tool-events mt-4">
            <h4 class="mb-3">Historial</h4>
            <% if tool_events.any? %>
              <ul class="list-group tool-events-list" data-batch-size="10">
                <% tool_events.each_with_index do |event, index| %>
                  <li class="list-group-item <%= 'tool-events-item-hidden d-none' if index >= 10 %>">
                    <%= event.description %>
                  </li>
                <% end %>
              </ul>

              <% if tool_events.size > 10 %>
                <div class="mt-3 text-center">
                  <button
                    type="button"
                    class="btn btn-outline-light btn-sm js-load-more-events"
                    data-load-count="10">
                    Ver 10 mas (<span class="js-events-remaining"><%= tool_events.size - 10 %></span> restantes)
                  </button>
                </div>
              <% end %>
            <% else %>
              <p class="mb-0">Todavia no hay eventos para esta herramienta.</p>
            <% end %>
          </div>

          <% if user_signed_in? %>
            <% if current_user.admin? || tool.user == current_user %>
              <div class="tool-actions mt-3">
                <%= link_to "Editar", edit_tool_path(tool), class: "btn btn-secondary" %>
                <%= button_to "Borrar", tool, method: :delete, data: { confirm: 'Are you sure?' }, class: "btn btn-danger mb-0" %>
              </div>
            <% end %>
          <% end %>

          <% unless modal %>
            <div class="mt-3">
              <%= link_to "Volver", tools_path, class: "btn btn-primary" %>
            </div>
            <br/>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
