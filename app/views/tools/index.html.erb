<p style="color: green"></p>

<% if user_signed_in? %>

  <%= form_tag(tools_path, method: :get, class: "form-inline mb-3") do %>
    <div class="form-group mr-2">
      <%= text_field_tag :search, params[:search], class: "form-control", placeholder: "Search..." %>
    </div> </br>
    <%= submit_tag "Search", class: "btn btn-outline-primary " %>
  <% end %>

  <%= link_to "Show Used Tools", used_tools_tools_path, class: "btn btn-outline-success mb-3" %>

  <table class="table table-striped table-bordered table-hover mt-3">
    <thead class="table-dark">
      <tr>
        <th>ID Tool</th>
        <th>Precinto</th>
        <th>Tipo</th>
        <th>Detalles</th>
      </tr>
    </thead>

    <tbody>
      <% @tools.each do |tool| %>
        <% if tool.user == current_user %>
          <tr>
            <td>
              <%= link_to tool.id_tool, tool %>
            </td>

            <td><%= tool.precinto %></td>
            <td><%= tool.clase %></td>
            <td>
              <button
                type="button"
                class="btn btn-outline-info btn-sm"
                data-bs-toggle="modal"
                data-bs-target="#toolDetailsModal-<%= tool.id %>">
                Detalles
              </button>
            </td>
          </tr>

        <% end %>
      <% end %>
      
    </tbody>
  </table>

  <% @tools.each do |tool| %>
    <% if tool.user == current_user %>
      <div
        class="modal fade tool-details-modal"
        id="toolDetailsModal-<%= tool.id %>"
        tabindex="-1"
        aria-labelledby="toolDetailsModalLabel-<%= tool.id %>"
        aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="toolDetailsModalLabel-<%= tool.id %>">
                Detalles de <%= tool.id_tool %>
              </h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <%= render partial: "tool", locals: { tool: tool, modal: true } %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>

  <br>

  <%= link_to "Agregar", new_tool_path, class: "btn btn-secondary" %>

  <br/>
  <br/>

  <%= link_to "Volver", root_path, class: "btn btn-dark" %>

<% else %>

  <h1 class="mt-5 text-center">Hola! Por favor ingresar</h1>

<% end %>
